{
  "files.associations": {
    "**/*.mcfunction": "mcfunction"
  },
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.vscode": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/Stellarity_TrueEnding_Patch_old/**": true,
    "**/recovered_deleted_files/**": true
  },
  "search.exclude": {
    "**/.git/**": true,
    "**/.vscode": true,
    "**/Stellarity_TrueEnding_Patch_old/**": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[mcfunction]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
  },
  "mc-dp-icons.crownedFunctionsNames": [
    "phantom/guard_tick",
    "portal/chorus_cleaner",
    "mechanics/tick",
    "egg/egg_tick",
    "dragon/invulnerability_guard",
    "mechanics/vortex_tick",
    "crystal/cleanup_trigger",
    "boss/a_main"
  ],
  "mc-dp-icons.crownedTickFunctionsNames": [
    "function/main_tick"
  ]
}