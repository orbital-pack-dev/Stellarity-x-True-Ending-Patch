{
  "initializer": {
    "lifetime": "110 + rand()*70",
    "alpha": "0",
    "size": "0",
    "custom": "rand()"
  },
  "ticker": {
    "alpha": "(0.7 + 0.3*sin(AGE*0.18 + CUSTOM*13000)) * min(AGE/(LIFETIME*0.15),1) * min((LIFETIME-AGE)/(LIFETIME*0.2),1)",
    "size": "(0.65 + CUSTOM*0.15) * min(AGE/(LIFETIME*0.12),1) * min((LIFETIME-AGE)/(LIFETIME*0.18),1)",
    "dx": "((0.014 + 0.006*sin(AGE*0.04 + CUSTOM*3000)) * sin(CUSTOM*200000 + AGE*0.035) + 0.01*sin(CUSTOM*90000 + AGE*0.012)) * 1.35",
    "dz": "((0.014 + 0.006*sin(AGE*0.04 + CUSTOM*3000)) * cos(CUSTOM*200000 + AGE*0.035) + 0.01*cos(CUSTOM*90000 + AGE*0.012)) * 1.35",
    "dy": "0.006*sin(AGE*0.08 + CUSTOM*9000)"
  },
  "tick_interval": 2,
  "liquid_affinity": "non_liquids",
  "lit": true,
  "light_level": 10,
  "render_type": "additive_translucent",
  "random_sprite": false,
  "kill_when_not_in_view": false,
  "has_physics": false,
  "kill_on_contact": false,
  "kill_when_still": false,
  "offset": [0, 0, 0],
  "exclusion_radius": 0.35,
  "hitbox_size": 0.12,
  "sound_emitters": [
    {
      "sound": "minecraft:block.firefly_bush.idle",
      "chance": "0.00025",
      "pitch": "0.9 + gaussian()*0.05"
    }
  ]
}