{
  "initializer": {
    "lifetime": "70 + rand() * 20 +( 500 * (RAIN == 0))",
    "alpha": "1",
    "size": "0",
    "hitbox_size": 0.35,
    "custom": "rand()",
    "roll": "rand() * 2 * pi"
  },
  "ticker": {
    "dx": "0.06 + (CUSTOM * 0.04) * sin(0.1 * AGE) + min( max((RAIN - 0.5) / 0.5, 0), 1) * (CUSTOM * 0.15) * sin(0.1 * AGE) ",
    "dy": "-0.05 - (AGE/LIFETIME)*0.2 - RAIN * 0.05",
