    "size": "(CUSTOM * 0.05 + 0.1) * min(max(AGE / 5, 0), 1) * min(max((LIFETIME - AGE) / 5, 0), 1)",
    "roll": "ROLL + CUSTOM * 0.06 + (RAIN)*(CUSTOM)*0.1",
    "remove_condition": "(DISTANCE_SQUARED > 40*40) + (SKY_LIGHT < 15)"
  },
  "random_sprite": true,
  "liquid_affinity": "non_liquids",
