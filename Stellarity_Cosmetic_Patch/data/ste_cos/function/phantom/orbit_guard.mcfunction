# =====================================================================
# ste_cos:phantom/orbit_guard
# AS marker AT маркера. Кружим фантома по орбите радиус 4 вокруг кристалла.
#
# Метод:
#   - вращаем маркер (Yaw +4°) каждый тик
#   - телепортируем фантома в 4 блоках перед маркером (^ ^ ^4)
#   - ловим фантома даже если он упал (distance=..40), чтобы вернуть на орбиту
#   - держим фантома привязанным к маркеру (не даём упасть)
# =====================================================================

# Поворачиваем маркер по часовой (4° за тик → ~90 тиков на оборот)
tp @s ~ ~ ~ ~4 ~

# Ставим фантома в 4 блоках перед маркером (ловит в радиусе 40)
execute at @s run tp @e[type=phantom,tag=ste_cos_guard,distance=..40,limit=1] ^ ^ ^4

# Фиксируем взгляд фантома к кристаллу (смотрит внутрь)
execute at @s run tp @e[type=phantom,tag=ste_cos_guard,distance=..40,limit=1] ~ ~ ~ ~ ~
