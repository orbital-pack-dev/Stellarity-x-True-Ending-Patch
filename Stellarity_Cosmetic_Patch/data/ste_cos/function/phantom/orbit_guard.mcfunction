# =====================================================================
# ste_cos:phantom/orbit_guard
# AS marker AT маркера. Кружим привязанного фантома по орбите радиус 4.
#
# Метод: вращаем маркер вокруг вертикальной оси (Yaw) на ~3.6° за каждый
# вызов, затем ставим фантома в 4 блоках перед маркером (^ ^ ^4).
# Результат: фантом плавно облетает кристалл по кругу.
# =====================================================================

# Поворачиваем маркер по часовой (увеличиваем Yaw на ~3.6° = 1 град/тик*? )
tp @s ~ ~ ~ ~3.6 ~

# Ставим фантома в 4 блоках перед маркером (в направлении взгляда)
execute at @s run tp @e[type=phantom,tag=ste_cos_guard,distance=..8,limit=1] ^ ^ ^4

# Небольшая фиксация взгляда фантома вниз к кристаллу
execute at @s run tp @e[type=phantom,tag=ste_cos_guard,distance=..8,limit=1] ~ ~ ~ ~ ~
