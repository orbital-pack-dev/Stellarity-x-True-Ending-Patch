# =====================================================================
# ste_cos:phantom/cleanup_guard
# Убивает фантома-стража и маркер, когда кристалл-хозяин умер.
# AS marker (ste_cos_guard_marker) AT маркера.
# =====================================================================

# Убиваем привязанного фантома (рядом с маркером)
execute at @s run kill @e[type=phantom,tag=ste_cos_guard,distance=..8,limit=1]

# Убиваем сам маркер
kill @s
