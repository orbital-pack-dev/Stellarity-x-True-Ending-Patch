# =====================================================================
# ste_cos:portal/chorus_cleaner
# Убирает хорус (и его цветы) вокруг портала Края, чтобы он не "багал" портал.
# Область: от ~0 50 0 до 0 75 0, в 20 блоков в каждую сторону (X/Z -20..20).
#
# Просто fill replace — заменяет только хорус на воздух, ничего больше не трогает.
# Вызывается раз в ~30 сек из main_tick.
# =====================================================================

fill -20 50 -20 20 75 20 minecraft:air replace minecraft:chorus_plant
fill -20 50 -20 20 75 20 minecraft:air replace minecraft:chorus_flower
