# =====================================================================
# ste_cos:portal/chorus_cleaner
# Очищает хорус (chorus_plant / chorus_flower) вокруг портала Края.
#
# Область: от ~0 50 0 до ~0 75 0, в каждую сторону 20 блоков
#   (X -20..20, Y 50..75, Z -20..20).
#
# Используем fill с replace по конкретному блоку:
#   fill <from> <to> air replace <block>
# (ваниль, дёшево — одна команда на объём).
#
# Вызывается периодически из main_tick.
# =====================================================================

# Убираем хорус-стебли/кусты
fill -20 50 -20 20 75 20 minecraft:air replace minecraft:chorus_plant

# Убираем хорус-цветы
fill -20 50 -20 20 75 20 minecraft:air replace minecraft:chorus_flower
