{
        "initializer":{
          "lifetime": "40",
          "alpha": "0",
          "size": "1.0",
          "custom": "rand()"
        },
        "ticker": {
          "alpha": "clamp(o.age() / 5.0, 0.0, 1.0) * 0.2",
          "dx": "global.rain() * 0.5",
          "dy": "-0.75",
          "dz": "CUSTOM * 0.08 - 0.04",
          "remove_condition": "distSquare(o.x(), o.z(), camera.x(), camera.z()) > 625"
