        "force_spawn": true,
        "tick_interval": 4,
        "exclusion_radius": 1,
        "offset": [0, 0.75, 0],
        "lit": true,
        "light_level": 5,

        "render_type": "additive_translucent",
        "rotation_mode": {
          "x_rot": "(o.z() < p.z() ? -0.45 : 0.45) * (o.x() > p.x() ? -1 : 1)",
