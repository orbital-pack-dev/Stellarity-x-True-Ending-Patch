{
  "initializer":{
    "lifetime": "100 + rand()*80",
    "size": "4",
    "alpha": "0",
    "roll": "rand()"
  },
      "ticker": {
        "alpha": "0.15 * sin((pi / LIFETIME) * AGE) * min(max((DISTANCE_SQUARED - 20) / 100, 0), 1) * max(0, min(1, (20 - sqrt(DISTANCE_SQUARED)) / 5))",
        "roll": "(CUSTOM*2*pi) + sin(AGE*0.025 + CUSTOM*2*pi) * 0.25",
        "dx": "0",
        "dy": "sin(AGE*0.04 + CUSTOM*2*pi) * 0.01",
        "dz": "0",
        "remove_condition": "DISTANCE_SQUARED > 20*20"
        },
  "render_type": "additive_translucent",
  "liquid_affinity": "non_liquids",
  "exclusion_radius": 2,
  "tick_interval": 2,
  "kill_when_not_in_view": false,
  "has_physics": false,
  "offset": [0, 0, 0]
}