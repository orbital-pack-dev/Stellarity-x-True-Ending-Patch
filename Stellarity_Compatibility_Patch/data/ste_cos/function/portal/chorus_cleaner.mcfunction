# =====================================================================
# ste_cos:portal/chorus_cleaner
# Убирает хорус (и цветы) возле портала Края, раз в ~30 сек.
#
#   Верхняя часть (Y 66..75): destroy — хорус выпадает предметом.
#   Нижняя часть (Y 50..65):  replace — не трогает портальные блоки.
# Так мы чистим хорус и снимаем его дроп, не разрушая рамку портала
# (destroy на нижнем слое мог бы снять обсидиан/структуру портала).
# =====================================================================

# Верх: хорус выпадает как предмет
fill -20 66 -20 20 75 20 minecraft:air destroy

# Низ: уборка хоруса (без ломания портальных блоков)
fill -20 50 -20 20 65 20 minecraft:air replace minecraft:chorus_plant
fill -20 50 -20 20 65 20 minecraft:air replace minecraft:chorus_flower

fill -20 50 -20 20 65 20 minecraft:air replace minecraft:bone_block

